# ==========================================
# REGGUARD BACKEND ENVIRONMENT VARIABLES
# ==========================================
# SECURITY: Never commit real values to GitHub
# Copy this file to .env and fill in your actual values
# .env is protected by .gitignore

# ==========================================
# STRIPE PAYMENT PROCESSING (PHASE 1)
# ==========================================
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXX

# Stripe Price IDs for tiers (create in Stripe Dashboard)
# Monthly subscriptions: monthly: price_...
# These can be retrieved from Stripe Dashboard → Products
