STRIPE_PRICE_IC_CONSULTANT=price_XXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_SPONSOR=price_XXXXXXXXXXXXXXXXXXXX

# ==========================================
# SUPABASE AUTHENTICATION (PHASE 2)
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase

# ==========================================
# APPLICATION URLS
# ==========================================
BACKEND_URL=https://regguard-api.onrender.com
FRONTEND_URL=https://regguardagent.com
FRONTEND_APP_URL=https://app.regguardagent.com

# ==========================================
# API KEYS (Get from respective services)
# ==========================================
