# Reg Guard — frontend environment template
# Copy this file to .env.local (Vite) and fill in your actual API keys
# DO NOT COMMIT .env files; only commit this .env.example

# ==========================================
# STRIPE PAYMENT PROCESSING (PHASE 1)
# ==========================================
# Stripe Publishable Key (frontend only - safe to expose)
VITE_STRIPE_PUBLIC_KEY=pk_test_XXXXXXXXXXXXXXXXXXXX

# ==========================================
# SUPABASE AUTHENTICATION (PHASE 2)
# ==========================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==========================================
# API CONFIGURATION
# ==========================================
# Backend API URL (change for prod/staging)
VITE_API_URL=http://localhost:8000

# ==========================================
# EXTERNAL SERVICES (Optional)
# ==========================================
VITE_GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXX

# ==========================================
# ANTHROPIC / LLM (Optional)
# ==========================================
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==========================================
# FIRECRAWL (Optional)
# ==========================================
VITE_FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ==========================================
# ENVIRONMENT
# ==========================================
VITE_ENVIRONMENT=development

